//@version=6
// LTF Sweep - 15m pool / 1m sweep / 1m CHoCH / FVG entry / fixed 1:1
// Compact build of ltf_sweep_strategy.pine - edit that file, not this one.
// Net negative over 10.7 years; profitable only since 2023. Evaluate on BAR
// CLOSE and set alerts to "Once Per Bar Close". Keep this file pure ASCII.
// Signals are evaluated on BAR CLOSE only. Set alerts to "Once Per Bar Close".

strategy("LTF Sweep - 15m pool / 1m CHoCH / 1:1", "LTF Sweep", overlay = true, initial_capital = 100000, currency = currency.USD, default_qty_type = strategy.fixed, default_qty_value = 1, margin_long = 0, margin_short = 0, calc_on_every_tick = false, process_orders_on_close = false, max_boxes_count = 200, max_lines_count = 300, max_labels_count = 300)

grpS = "Setup"
lookbackCandles = input.int(4,    "15m candles forming the pool", minval=1, maxval=20, group=grpS)
minPen          = input.float(0.25,"Minimum penetration (points)", minval=0.0, step=0.25, group=grpS)
minFvgSize      = input.float(0.5, "Minimum FVG size (points)",    minval=0.0, step=0.25, group=grpS)
confirmWithin   = input.int(30,   "CHoCH must follow within N bars", minval=1, group=grpS)
pivotLen        = input.int(2,    "Swing pivot length",            minval=1, group=grpS)
oneTradePerDay  = input.bool(true,"One trade per day",             group=grpS)

grpR = "Risk"
stopBuffer   = input.float(1.0,  "Stop buffer beyond extreme (pts)", minval=0.0, step=0.25, group=grpR)
targetR      = input.float(1.0,  "Target (R multiple)",   minval=0.1, step=0.25, group=grpR)
riskUSD      = input.float(500,  "Risk per trade (USD)",  minval=1,   group=grpR)
pointValue   = input.float(2.0,  "$ per point (MNQ=2, NQ=20)", minval=0.01, group=grpR)
minRiskPts   = input.float(1.0,  "Min risk (points)",     minval=0.0, group=grpR)
maxRiskPts   = input.float(120.0,"Max risk (points)",     minval=1.0, group=grpR)

grpT = "Session (exchange time of the chart symbol)"
sweepWindow  = input.session("0930-1500", "Sweeps accepted",   group=grpT)
entryWindow  = input.session("0930-1530", "Limit order live",  group=grpT)
tradeSession = input.session("0930-1600", "Session / flat by", group=grpT)
tz           = input.string("America/New_York", "Timezone",    group=grpT)

grpV = "Display"
showPool  = input.bool(true, "15m liquidity pool",  group=grpV)
showFvg   = input.bool(true, "FVG boxes",           group=grpV)
showLevels= input.bool(true, "Entry / stop / target", group=grpV)
showTable = input.bool(true, "Status table",        group=grpV)

grpA = "Alerts"
alertTemplate = input.string( '{"strategy":"ltf_sweep","action":"%ACTION%","symbol":"%SYMBOL%","qty":%QTY%,"entry":%ENTRY%,"stop":%STOP%,"target":%TARGET%,"risk_points":%RISKPTS%,"time":"%TIME%"}', "Alert JSON template", group=grpA)

grpP = "Prop firm"
propMode     = input.bool(false, "Enforce prop firm rules", group=grpP)
firmPreset   = input.string("Topstep 50K", "Account", group=grpP, options=["Topstep 50K", "Topstep 100K", "Topstep 150K", "Apex 50K EOD", "Apex 100K EOD", "Custom"])
accountStart = input.float(50000, "Account starting balance", minval=1, group=grpP)
riskPctOfMLL = input.float(10, "Risk per trade, % of the loss limit", minval=1, maxval=50, group=grpP)
safetyMult   = input.float(1.5, "Refuse to open within N x risk of the limit", minval=1.0, step=0.25, group=grpP)
cTarget      = input.float(3000, "Custom: profit target",       group=grpP)
cMaxLoss     = input.float(2000, "Custom: maximum loss limit",  group=grpP)
cDailyLoss   = input.float(1000, "Custom: daily loss limit",    group=grpP)
cMaxMicros   = input.int(50,     "Custom: max micro contracts", group=grpP)

var int pIdx = array.indexof(array.from("Topstep 50K", "Topstep 100K", "Topstep 150K", "Apex 50K EOD", "Apex 100K EOD"), firmPreset)
var float profitTarget   = pIdx < 0 ? cTarget    : array.get(array.from(3000., 6000., 9000., 3000., 6000.), pIdx)
var float maxLossLimit   = pIdx < 0 ? cMaxLoss   : array.get(array.from(2000., 3000., 4500., 2500., 3000.), pIdx)
var float dailyLossLimit = pIdx < 0 ? cDailyLoss : array.get(array.from(1000., 2000., 3000., 1e9, 1e9), pIdx)
var int   maxMicros      = pIdx < 0 ? cMaxMicros : int(array.get(array.from(50., 100., 150., 20., 40.), pIdx))

effRisk = propMode ? maxLossLimit * riskPctOfMLL / 100.0 : riskUSD

propBlock(liveEq, floorEq, dayPnl, netP, plannedRisk) =>
    not propMode ? 0 : liveEq - floorEq < plannedRisk * safetyMult ? 1 : dayPnl - plannedRisk <= -dailyLossLimit ? 2 : netP >= profitTarget ? 3 : 0

grpD = "Diagnostics"
showDiag = input.bool(true, "Diagnostic counters in the table", group=grpD)
debugLog = input.bool(true, "Trace to the Pine Logs tab",       group=grpD)

var int nBarsSession = 0
var int nSweep       = 0
var int nChoch       = 0
var int nConfirm     = 0
var int nRejRisk     = 0
var int nRejQty      = 0
var int nArmed       = 0
var int nBlockMLL    = 0
var int nBlockDaily  = 0
var int nBlockTgt    = 0
var int nClampQty    = 0
var int nSameBar     = 0    // trades that opened and closed inside one bar

var float mllFloor  = na
var float dayOpenEq = na

px(v) => str.tostring(v, format.mintick)

inSweepWin = not na(time(timeframe.period, sweepWindow,  tz))
inEntryWin = not na(time(timeframe.period, entryWindow,  tz))
inSession  = not na(time(timeframe.period, tradeSession, tz))
sessionOpen = inSession and not inSession[1]
sessionEnd  = not inSession and inSession[1]

var int barsSinceOpen = 0
barsSinceOpen := sessionOpen ? 1 : inSession ? barsSinceOpen + 1 : 0
if inSession
    nBarsSession += 1

// The [1] offset and lookahead_on are interdependent: together they return the
// last CLOSED 15m bar's value. Removing either reintroduces lookahead bias.
poolHigh = request.security(syminfo.tickerid, "15", ta.highest(high, lookbackCandles)[1], lookahead = barmerge.lookahead_on)
poolLow  = request.security(syminfo.tickerid, "15", ta.lowest(low,   lookbackCandles)[1], lookahead = barmerge.lookahead_on)

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,   pivotLen, pivotLen)

pivotReady = barsSinceOpen > (pivotLen * 2)

var float pendHigh = na
var float pendLow  = na
var int   trendDir = 0

if sessionOpen
    pendHigh := na
    pendLow  := na
    trendDir := 0

bullBreak = inSession and not na(pendHigh) and close > pendHigh
bearBreak = inSession and not na(pendLow)  and close < pendLow
bullChoch = bullBreak and trendDir < 0
bearChoch = bearBreak and trendDir > 0
brokenLevel = bullBreak ? pendHigh : bearBreak ? pendLow : na
if bullChoch or bearChoch
    nChoch += 1

if bullBreak
    trendDir := 1
    pendHigh := na
else if bearBreak
    trendDir := -1
    pendLow  := na

if pivotReady and not na(ph)
    pendHigh := ph
if pivotReady and not na(pl)
    pendLow := pl

fvgReady   = barsSinceOpen > 3
bullFvg    = fvgReady and low > high[2] and (low - high[2]) >= minFvgSize
bearFvg    = fvgReady and high < low[2] and (low[2] - high) >= minFvgSize
bullFvgTop = low
bullFvgBot = high[2]
bearFvgTop = low[2]
bearFvgBot = high

var int    stage      = 0     // 0 waiting, 1 swept, 2 order working
var int    setupDir   = 0     // +1 long, -1 short
var float  sweptLevel = na
var float  protective = na    // furthest point reached against the trade
var int    sweepBar   = 0
var float  fvgTop     = na
var float  fvgBot     = na
var int    fvgBar     = 0     // bar the gap's third candle closed on
var bool   tradedToday= false
var float  entryPx    = na
var float  stopPx     = na
var float  targetPx   = na
var int    qty        = 0

if sessionOpen
    stage       := 0
    setupDir    := 0
    sweepBar    := 0
    sweptLevel  := na
    protective  := na
    fvgTop      := na
    fvgBot      := na
    tradedToday := false
    entryPx     := na
    stopPx      := na
    targetPx    := na
    qty         := 0

sweepHigh = inSweepWin and stage == 0 and not tradedToday and not na(poolHigh) and high > poolHigh + minPen and close < poolHigh
sweepLow  = inSweepWin and stage == 0 and not tradedToday and not na(poolLow)  and low  < poolLow  - minPen and close > poolLow

if sweepHigh or sweepLow
    stage      := 1
    setupDir   := sweepHigh ? -1 : 1
    sweptLevel := sweepHigh ? poolHigh : poolLow
    protective := sweepHigh ? high : low
    sweepBar   := bar_index
    fvgTop     := na
    fvgBot     := na
    nSweep     += 1
    if debugLog
        log.info("sweep " + (sweepHigh ? "HIGH " : "LOW ") + px(sweptLevel) + " -> awaiting " + (sweepHigh ? "bearish" : "bullish") + " CHoCH")

// afterSweep enforces the research version's `confirmed_at > sweep_confirmed`:
afterSweep = stage == 1 and bar_index > sweepBar
if stage == 1
    protective := setupDir == 1 ? math.min(protective, low) : math.max(protective, high)
    if afterSweep and setupDir == 1 and bullFvg
        fvgTop := bullFvgTop
        fvgBot := bullFvgBot
        fvgBar := bar_index
    if afterSweep and setupDir == -1 and bearFvg
        fvgTop := bearFvgTop
        fvgBot := bearFvgBot
        fvgBar := bar_index

expired = stage == 1 and (bar_index - sweepBar) > confirmWithin
if expired
    stage := 0
    setupDir := 0

confirmed = afterSweep and not na(fvgTop) and ((setupDir == 1 and bullChoch) or (setupDir == -1 and bearChoch))

if confirmed
    nConfirm += 1
    e = (fvgTop + fvgBot) / 2.0
    s = setupDir == 1 ? protective - stopBuffer : protective + stopBuffer
    r = math.abs(e - s)
    ok = r >= minRiskPts and r <= maxRiskPts and (setupDir == 1 ? s < e : s > e)
    q0 = ok ? int(math.floor(effRisk / (r * pointValue))) : 0
    q = propMode and q0 > maxMicros ? maxMicros : q0
    if propMode and q0 > maxMicros
        nClampQty += 1
    if ok and q >= 1
        entryPx  := e
        stopPx   := s
        targetPx := e + setupDir * targetR * r
        qty      := q
        stage    := 2
        nArmed   += 1
        if debugLog
            log.info("armed " + (setupDir == 1 ? "LONG" : "SHORT") + "  entry " + px(e) + "  stop " + px(s) + "  target " + px(targetPx) + "  risk " + str.tostring(r, "#.##") + " pts  qty " + str.tostring(q))
    else
        if not ok
            nRejRisk += 1
        else
            nRejQty += 1
        if debugLog
            log.warning("rejected: risk " + str.tostring(r, "#.##") + " pts (band " + str.tostring(minRiskPts) + "-" + str.tostring(maxRiskPts) + "), budget $" + str.tostring(effRisk, "#") + ", qty " + str.tostring(q))
        stage    := 0
        setupDir := 0

isoTime  = str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")
msg(action, q, e, s, t, rp) =>
    m = str.replace_all(alertTemplate, "%QTY%", str.tostring(q))
    m := str.replace_all(m, "%ACTION%",  action)
    m := str.replace_all(m, "%SYMBOL%",  syminfo.ticker)
    m := str.replace_all(m, "%ENTRY%",   str.tostring(e, format.mintick))
    m := str.replace_all(m, "%STOP%",    str.tostring(s, format.mintick))
    m := str.replace_all(m, "%TARGET%",  str.tostring(t, format.mintick))
    m := str.replace_all(m, "%RISKPTS%", str.tostring(rp, "#.##"))
    m := str.replace_all(m, "%TIME%",    isoTime)
    m

riskPts = na(entryPx) or na(stopPx) ? 0.0 : math.abs(entryPx - stopPx)

propEquity = accountStart + strategy.netprofit + strategy.openprofit
if na(mllFloor)
    mllFloor  := accountStart - maxLossLimit
    dayOpenEq := accountStart
if sessionOpen
    dayOpenEq := propEquity
if sessionEnd
    mllFloor := math.max(mllFloor, accountStart + strategy.netprofit - maxLossLimit)
dayPnl      = propEquity - dayOpenEq
plannedRisk = riskPts * pointValue * qty
blockReason = propBlock(propEquity, mllFloor, dayPnl, strategy.netprofit, plannedRisk)

if stage == 2 and strategy.position_size == 0 and strategy.opentrades == 0
    if blockReason != 0
        nBlockMLL   += blockReason == 1 ? 1 : 0
        nBlockDaily += blockReason == 2 ? 1 : 0
        nBlockTgt   += blockReason == 3 ? 1 : 0
        if debugLog
            log.warning("BLOCKED (" + (blockReason == 1 ? "loss limit" : blockReason == 2 ? "daily cap" : "target made") + ") room $" + str.tostring(propEquity - mllFloor, "#") + ", risk $" + str.tostring(plannedRisk, "#"))
        strategy.cancel("LTF")
        stage    := 0
        setupDir := 0
    else
        if setupDir == 1
            strategy.entry("LTF", strategy.long, qty = qty, limit = entryPx, alert_message = msg("buy", qty, entryPx, stopPx, targetPx, riskPts))
        else
            strategy.entry("LTF", strategy.short, qty = qty, limit = entryPx, alert_message = msg("sell", qty, entryPx, stopPx, targetPx, riskPts))
        strategy.exit("LTF x", "LTF", stop = stopPx, limit = targetPx, alert_message = msg("exit", qty, entryPx, stopPx, targetPx, riskPts))

// it, because a round trip inside one bar still increments closedtrades.
// first bar. Same-bar round trips are routine at a 1:1 target: two of the
tradesTaken = strategy.closedtrades + strategy.opentrades
justFilled  = tradesTaken > nz(tradesTaken[1], 0)
if justFilled
    tradedToday := oneTradePerDay ? true : tradedToday
    if debugLog
        log.info("filled " + str.tostring(qty) + " @ " + px(entryPx) + (strategy.position_size == 0 ? " (opened and closed in one bar)" : ""))
    if strategy.position_size == 0
        nSameBar += 1
        stage    := 0
        setupDir := 0

if stage == 2 and not inEntryWin and strategy.position_size == 0
    strategy.cancel("LTF")
    if debugLog
        log.info("entry window closed with the limit unfilled at " + px(entryPx))
    stage := 0
    setupDir := 0

if sessionEnd
    strategy.cancel_all()
    if strategy.position_size != 0
        strategy.close_all(comment = "session end", alert_message = msg("close", qty, entryPx, stopPx, targetPx, riskPts))
    stage := 0
    setupDir := 0

// The same-bar round trip is handled above, where it is actually visible.
if strategy.position_size == 0 and strategy.position_size[1] != 0
    stage := 0
    setupDir := 0

poolBroken = stage >= 1
plot(showPool and inSession and not na(poolHigh) ? poolHigh : na, "Pool high", color = poolBroken and setupDir == -1 ? color.new(color.red, 20) : color.new(#4a3aa7, 35), style = plot.style_stepline, linewidth = 1)
plot(showPool and inSession and not na(poolLow) ? poolLow : na, "Pool low", color = poolBroken and setupDir == 1 ? color.new(color.green, 20) : color.new(#4a3aa7, 35), style = plot.style_stepline, linewidth = 1)

bgcolor(inSession ? color.new(color.blue, 96) : na, title = "Session")

plotshape(sweepHigh, "Sweep high", shape.triangledown, location.abovebar, color.new(color.red, 0), size = size.tiny)
plotshape(sweepLow,  "Sweep low",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size = size.tiny)
plotshape(confirmed and setupDir == 1,  "CHoCH up",   shape.diamond, location.belowbar, color.new(#15734a, 0), size = size.tiny)
plotshape(confirmed and setupDir == -1, "CHoCH down", shape.diamond, location.abovebar, color.new(#c0322f, 0), size = size.tiny)

if showFvg and confirmed
    box.new(fvgBar - 2, fvgTop, bar_index + 20, fvgBot, border_color = color.new(#eda100, 40), bgcolor = color.new(#eda100, 80))
    if not na(brokenLevel)
        line.new(bar_index - 3, brokenLevel, bar_index + 8, brokenLevel, color = color.new(#5a6572, 30), style = line.style_dotted)

plot(showLevels and stage == 2 and not na(entryPx) ? entryPx : na, "Entry", color.new(#1f4b8f, 0), style = plot.style_linebr, linewidth = 1)
plot(showLevels and strategy.position_size != 0 and not na(stopPx) ? stopPx : na, "Stop", color.new(#c0322f, 0), style = plot.style_linebr, linewidth = 1)
plot(showLevels and strategy.position_size != 0 and not na(targetPx) ? targetPx : na, "Target", color.new(#15734a, 0), style = plot.style_linebr, linewidth = 1)

var table info = table.new(position.top_right, 2, 14, bgcolor = color.new(color.black, 20), border_width = 1)
row(r, k, v, c) =>
    table.cell(info, 0, r, k, text_color = color.gray, text_size = size.tiny)
    table.cell(info, 1, r, v, text_color = c, text_size = size.tiny)

if showTable and barstate.islast
    state = strategy.position_size != 0 ? "IN TRADE" : stage == 2 ? "order working" : stage == 1 ? "swept - awaiting CHoCH" : tradedToday ? "done for today" : "waiting"
    table.cell(info, 0, 0, "LTF Sweep", text_color = color.white, text_size = size.small)
    table.cell(info, 1, 0, state, text_color = color.yellow, text_size = size.small)
    row(1, stage >= 1 ? "swept level" : "pool hi/lo", stage >= 1 and not na(sweptLevel) ? px(sweptLevel) : px(poolHigh) + " / " + px(poolLow), color.white)
    row(2, "direction", setupDir == 1 ? "LONG" : setupDir == -1 ? "SHORT" : "-", setupDir == 1 ? color.lime : setupDir == -1 ? color.red : color.gray)
    row(3, "entry", na(entryPx) ? "-" : px(entryPx), color.white)
    row(4, "stop / target", na(stopPx) ? "-" : px(stopPx) + " / " + px(targetPx), color.white)
    row(5, "risk / qty", str.tostring(riskPts, "#.##") + " pts - " + str.tostring(qty) + " ct", color.white)
    row(6, "risk $", "$" + str.tostring(riskPts * pointValue * qty, "#"), color.white)
    if showDiag
        tfOk = timeframe.period == "1"
        filled = strategy.closedtrades + strategy.opentrades
        row(7, "chart", syminfo.ticker + " tf=" + timeframe.period + (tfOk ? "" : " NEEDS 1"), tfOk ? color.white : color.red)
        row(8, "sess/swp/chc", str.tostring(nBarsSession) + " / " + str.tostring(nSweep) + " / " + str.tostring(nChoch), nSweep > 0 ? color.white : color.red)
        row(9, "conf/armed/rej", str.tostring(nConfirm) + " / " + str.tostring(nArmed) + " / " + str.tostring(nRejRisk + nRejQty), nArmed > 0 ? color.white : color.red)
        row(10, "FILLED", str.tostring(filled) + " (" + str.tostring(nSameBar) + " same-bar)", filled > 0 ? color.lime : color.red)
    if propMode
        room = propEquity - mllFloor
        row(11, "loss limit", px(mllFloor) + "  room $" + str.tostring(room, "#"), room > plannedRisk * safetyMult * 2 ? color.white : color.red)
        row(12, "day / target", "$" + str.tostring(dayPnl, "#") + "  /  $" + str.tostring(strategy.netprofit, "#") + " of $" + str.tostring(profitTarget, "#"), strategy.netprofit >= profitTarget ? color.lime : color.white)
        row(13, "blocked / clamped", str.tostring(nBlockMLL) + " limit, " + str.tostring(nBlockDaily) + " daily, " + str.tostring(nBlockTgt) + " done, " + str.tostring(nClampQty) + " cut", nBlockMLL > 0 ? color.orange : color.gray)

var label tfWarn = na
if barstate.islast and timeframe.period != "1"
    label.delete(tfWarn)
    tfWarn := label.new(bar_index, high, "LTF Sweep needs a 1-MINUTE chart -- this one is " + timeframe.period + ".\n" + "The model is a 15m pool swept by a 1m bar and confirmed by a 1m CHoCH.\n" + "That structure does not exist here, so no setup will ever complete.", color = color.new(color.red, 10), textcolor = color.white, style = label.style_label_down, size = size.normal)
